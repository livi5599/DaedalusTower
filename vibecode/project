“Create me a simple character moving script that only moves with wasd no jumping or anything else fancy. Make it physics based and make sure it doesn't clip on anything like walls or floors”

using UnityEngine;

[RequireComponent(typeof(Rigidbody))]
public class MoveWithPhysics : MonoBehaviour
{
    public float moveSpeed = 5f;

    Rigidbody rb;
    Vector3 moveInput;
    Vector3 moveVelocity;

    void Awake()
    {
        rb = GetComponent<Rigidbody>();
        rb.freezeRotation = true;
    }

    void Update()
    {
        float h = Input.GetAxisRaw("Horizontal"); // A D
        float v = Input.GetAxisRaw("Vertical");   // W S

        // movement direction based on player forward/right
        moveInput = (transform.forward * v + transform.right * h).normalized;
        moveVelocity = moveInput * moveSpeed;
    }

    void FixedUpdate()
    {
        // keeps physics consistent
        rb.MovePosition(rb.position + moveVelocity * Time.fixedDeltaTime);
    }
}

